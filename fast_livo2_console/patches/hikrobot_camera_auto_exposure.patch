+    bool Camera::configureExposure()
+    {
+        if (ExposureAutoString != "Off" && ExposureAutoString != "Once" && ExposureAutoString != "Continuous")
+        {
+            ROS_ERROR("Unsupported ExposureAutoString '%s'; falling back to manual exposure", ExposureAutoString.c_str());
+            ExposureAutoString = "Off";
+        }
+
+        nRet = MV_CC_SetEnumValueByString(handle, "ExposureAuto", "Off");
+        if (MV_OK != nRet)
+        {
+            ROS_ERROR("Cannot disable ExposureAuto, ret=[%x]", nRet);
+            return false;
+        }
+
+        if (ExposureAutoString == "Off")
+        {
+            this->set(CAP_PROP_EXPOSURE_TIME, ExposureTime);
+            return nRet == MV_OK;
+        }
+
+        nRet = MV_CC_SetEnumValueByString(handle, "GainAuto", "Off");
+        if (MV_OK != nRet)
+        {
+            ROS_ERROR("Cannot force GainAuto=Off for automatic exposure, ret=[%x]", nRet);
+            ExposureAutoString = "Off";
+            this->set(CAP_PROP_EXPOSURE_TIME, ExposureTime);
+            return false;
+        }
+
+        bool aoi_ok = true;
+        aoi_ok = MV_CC_SetEnumValue(handle, "AutoFunctionAOISelector", 0) == MV_OK && aoi_ok;
+        aoi_ok = MV_CC_SetIntValue(handle, "AutoFunctionAOIWidth", AutoExposureAOIWidth) == MV_OK && aoi_ok;
+        aoi_ok = MV_CC_SetIntValue(handle, "AutoFunctionAOIHeight", AutoExposureAOIHeight) == MV_OK && aoi_ok;
+        aoi_ok = MV_CC_SetIntValue(handle, "AutoFunctionAOIOffsetX", AutoExposureAOIOffsetX) == MV_OK && aoi_ok;
+        aoi_ok = MV_CC_SetIntValue(handle, "AutoFunctionAOIOffsetY", AutoExposureAOIOffsetY) == MV_OK && aoi_ok;
+        aoi_ok = MV_CC_SetBoolValue(handle, "AutoFunctionAOIUsageIntensity", AutoExposureAOIUsageIntensity) == MV_OK && aoi_ok;
+        if (!aoi_ok)
+        {
+            ROS_WARN("Central automatic-exposure AOI is unavailable; falling back to full image");
+            MV_CC_SetIntValue(handle, "AutoFunctionAOIOffsetX", 0);
+            MV_CC_SetIntValue(handle, "AutoFunctionAOIOffsetY", 0);
+            MV_CC_SetIntValue(handle, "AutoFunctionAOIWidth", width);
+            MV_CC_SetIntValue(handle, "AutoFunctionAOIHeight", height);
+            MV_CC_SetBoolValue(handle, "AutoFunctionAOIUsageIntensity", true);
+        }
+
+        int lower_ret = MV_CC_SetIntValue(handle, "AutoExposureTimeLowerLimit", (unsigned int)AutoExposureTimeLowerLimit);
+        int upper_ret = MV_CC_SetIntValue(handle, "AutoExposureTimeUpperLimit", (unsigned int)AutoExposureTimeUpperLimit);
+        if (MV_OK != lower_ret || MV_OK != upper_ret)
+        {
+            ROS_ERROR("Cannot set automatic exposure limits %.0f..%.0f us, ret=[%x,%x]; using manual exposure",
+                      AutoExposureTimeLowerLimit, AutoExposureTimeUpperLimit, lower_ret, upper_ret);
+            ExposureAutoString = "Off";
+            this->set(CAP_PROP_EXPOSURE_TIME, ExposureTime);
+            return false;
+        }
+
+        nRet = MV_CC_SetEnumValueByString(handle, "ExposureAuto", ExposureAutoString.c_str());
+        if (MV_OK != nRet)
+        {
+            ROS_ERROR("Cannot enable ExposureAuto=%s, ret=[%x]; using manual exposure", ExposureAutoString.c_str(), nRet);
+            ExposureAutoString = "Off";
+            MV_CC_SetEnumValueByString(handle, "ExposureAuto", "Off");
+            this->set(CAP_PROP_EXPOSURE_TIME, ExposureTime);
+            return false;
+        }
+        ROS_INFO("ExposureAuto=%s, limits=%.0f..%.0f us, AOI=%dx%d+%d+%d, GainAuto=Off",
+                 ExposureAutoString.c_str(), AutoExposureTimeLowerLimit, AutoExposureTimeUpperLimit,
+                 AutoExposureAOIWidth, AutoExposureAOIHeight, AutoExposureAOIOffsetX, AutoExposureAOIOffsetY);
+        return true;
+    }
